# Copy to .dev.vars for local development. Never commit .dev.vars.
# Values here override the production vars in wrangler.jsonc.
PUBLIC_SITE_URL=http://localhost:8787
PUBLIC_GITHUB_REPO=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# OAuth apps (optional locally; the provider button is hidden when unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile test secret that always passes (use real secret in production)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Comments and reports (off in production until reviewed on staging)
COMMENTS_ENABLED=true

# Optional GitHub token to raise the API rate limit for the star counter (no scopes needed)
GITHUB_TOKEN=
