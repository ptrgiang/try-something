---
// Shell for /me/settings/*: one centered page with a section nav (sidebar on desktop, tabs on phones).
import Base from "./Base.astro";
import Icon from "../components/Icon.astro";

interface Props {
  current: "profile" | "sign-in" | "account";
  title: string;
  lede?: string;
}
const { current, title, lede } = Astro.props;
const user = Astro.locals.user!;
const sections = [
  { id: "profile", href: "/me/settings", label: "Profile", icon: "user" },
  { id: "sign-in", href: "/me/settings/sign-in", label: "Sign-in methods", icon: "link" },
  { id: "account", href: "/me/settings/account", label: "Delete account", icon: "trash" },
] as const;
---
<Base title={`${title} · Settings`} noindex>
  <div class="page app-page">
    <header class="settings-head">
      <p class="eyebrow">Your account</p>
      <h1 class="page-title">Settings</h1>
      <p class="settings-who">Signed in as <strong>{user.email}</strong></p>
    </header>
    <div class="settings-shell">
      <nav class="settings-nav" aria-label="Settings">
        {sections.map((s) => (
          <a href={s.href} aria-current={s.id === current ? "page" : undefined} class={s.id === "account" ? "is-danger" : undefined}>
            <Icon name={s.icon} />
            {s.label}
          </a>
        ))}
        {user.handle && (
          <a class="settings-nav-extra" href={`/users/${user.handle}`}>
            <Icon name="arrow" />
            View public profile
          </a>
        )}
      </nav>
      <section class="settings-main" aria-labelledby="settings-title">
        <header class="settings-section-head">
          <h2 id="settings-title">{title}</h2>
          {lede && <p>{lede}</p>}
        </header>
        <slot />
      </section>
    </div>
  </div>
</Base>
