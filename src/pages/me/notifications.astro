---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import LiveBanner from "../../components/LiveBanner.astro";
import Sticker from "../../components/Sticker.astro";
import { listNotifications, markNotificationsRead } from "../../lib/db";
import { NOTIFICATION_DAYS, notificationView } from "../../lib/notifications";
import { timeAgo } from "../../lib/util";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login?next=/me/notifications");
// Read the list first so this visit still shows what was new, then clear the bell before the header renders.
const items = (await listNotifications(env.DB, user.id)).map(notificationView).filter((n) => n !== null);
if (items.some((n) => n.unread)) await markNotificationsRead(env.DB, user.id);
const live = items.find((n) => n.unread && n.live)?.live;
---
<Base title="Notifications" noindex>
  <div class="page app-page">
    <p class="eyebrow">Your account</p>
    <h1 class="page-title">Notifications</h1>
    {live && <LiveBanner {...live} />}
    {items.length ? (
      <>
        <p class="section-intro notif-intro">Reviews of your submissions and new comments on your tools and comments, from the last {NOTIFICATION_DAYS} days.</p>
        <ul class="notif-list">
          {items.map((n) => (
            <li>
              <a class:list={["notif", { "is-unread": n.unread }]} href={n.href}>
                <span class="notif-icon" aria-hidden="true"><Icon name={n.icon} /></span>
                <span class="notif-body">
                  <span class="notif-title">{n.unread && <span class="sr-only">New: </span>}{n.title}</span>
                  {n.detail && <span class="notif-detail">{n.detail}</span>}
                  <time class="notif-time" datetime={n.created_at}>{timeAgo(n.created_at)}</time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <div class="gate">
        <Sticker name="bell" size="md" />
        <h2>Nothing new yet</h2>
        <p>When an editor reviews something you submitted, or someone comments on your tool or replies to you, it shows up here.</p>
        <a class="btn btn-dark" href="/submit">Submit a tool</a>
      </div>
    )}
  </div>
</Base>
