---
import { env } from "cloudflare:workers";
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import LiveBanner from "../../../components/LiveBanner.astro";
import Sticker from "../../../components/Sticker.astro";
import MakerInsights from "../../../components/MakerInsights.astro";
import { listMySubmissions, myToolInsights } from "../../../lib/db";
import { STATUS_LABELS } from "../../../lib/moderation";
import { dateRange } from "../../../lib/analytics";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login?next=/me/submissions");
const [subs, insights] = await Promise.all([listMySubmissions(env.DB, user.id), myToolInsights(env.DB, user.id, dateRange(30))]);
const justSubmitted = Astro.url.searchParams.get("submitted");
// Approval stamps updated_at, so a published row touched this week is a tool that just went live.
const fresh = subs.find((s) => s.status === "published" && s.tool_slug && Date.now() - Date.parse(s.updated_at) < 7 * 86_400_000);
const updateNotice = { sent: "Update sent. An editor will review it before it shows on the tool page.", withdrawn: "Update withdrawn." }[Astro.url.searchParams.get("update") ?? ""];
---
<Base title="My submissions" noindex>
  <div class="page app-page">
    <p class="eyebrow">Your account</p>
    <h1 class="page-title">My submissions</h1>
    {justSubmitted && subs.some((s) => s.id === justSubmitted) && (
      <div class="notice notice-success notice-sticker submit-body" role="status">
        <Sticker name="plane" size="sm" />
        <p>Thanks! Your submission is <strong>pending review</strong>. An editor will check the link and the 30-second try before it goes live. You'll see the status here.</p>
      </div>
    )}
    {fresh?.tool_slug && <LiveBanner name={fresh.name} slug={fresh.tool_slug} made={fresh.tool_made} />}
    {updateNotice && <p class="notice notice-success submit-body" role="status">{updateNotice}</p>}
    {insights.length > 0 && (
      <section class="insights submit-body" aria-labelledby="insights-title">
        <h2 id="insights-title" class="section-title">Your listed tools</h2>
        <p class="muted small-note">Last 30 days (UTC), counted on this site only. A try click means someone opened your site, not that they used it. Visitors count once per tool per day; saves and hearts are from signed-in accounts.</p>
        <div class="maker-tools">{insights.map((t) => <MakerInsights tool={t} />)}</div>
      </section>
    )}
    {subs.length ? (
      <div class="table-wrap submit-body">
        <table>
          <thead><tr><th>Tool</th><th>Type</th><th>Status</th><th>Editor note</th><th>Submitted</th><th><span class="sr-only">Actions</span></th></tr></thead>
          <tbody>
            {subs.map((s) => (
              <tr>
                <td><strong>{s.name}</strong><br /><span class="muted small-note">{s.url}</span></td>
                <td>{s.origin === "made" ? "I made this" : "I found this"}</td>
                <td><span class={`status status-${s.status}`}>{STATUS_LABELS[s.status]}</span></td>
                <td>{s.status === "needs_changes" || s.status === "rejected" ? s.moderator_note : ""}</td>
                <td><time datetime={s.created_at}>{s.created_at.slice(0, 10)}</time></td>
                <td>
                  {s.tool_slug ? (
                    <>
                      <a href={`/tools/${s.tool_slug}`}>View live</a>
                      {s.origin === "made" && (s.tool_verified_at ? <span class="verified-chip"><Icon name="check" />Verified</span> : <a class="verify-link" href={`/me/verify/${s.tool_slug}`}>Verify you made it</a>)}
                    </>
                  ) : <a href={`/me/submissions/${s.id}`}>{s.status === "needs_changes" ? "Edit & resubmit" : "Details"}</a>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="empty submit-body"><p>You haven't submitted anything yet.</p><a class="btn btn-dark" href="/submit">Submit a tool</a></div>
    )}
  </div>
</Base>
