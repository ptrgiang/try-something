---
import { env } from "cloudflare:workers";
import Base from "../../../../layouts/Base.astro";
import ToolCard from "../../../../components/ToolCard.astro";
import Avatar from "../../../../components/Avatar.astro";
import Icon from "../../../../components/Icon.astro";
import { getProfileByHandle, getPublicList, LIST_INDEX_MIN, listItems } from "../../../../lib/db";
import { avatarUrl } from "../../../../lib/avatar";
import { isModerator } from "../../../../lib/moderation";

const profile = await getProfileByHandle(env.DB, Astro.params.handle ?? "");
if (!profile) return Astro.rewrite("/404");
if (Astro.params.handle !== profile.handle) return Astro.redirect(`/users/${profile.handle}/lists/${Astro.params.slug}`, 301);
const me = Astro.locals.user;
const list = await getPublicList(env.DB, profile.id, Astro.params.slug ?? "", isModerator(me?.role));
if (!list) return Astro.rewrite("/404");
const tools = await listItems(env.DB, list.id);
const path = `/users/${profile.handle}/lists/${list.slug}`;
const description = list.description || `${list.title}: ${tools.length} ${tools.length === 1 ? "tool" : "tools"} to try in your browser, picked by ${profile.name}.`;
const updated = new Date(list.updated_at).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<Base
  title={`${list.title} by ${profile.name}`}
  description={description}
  path={path}
  noindex={tools.length < LIST_INDEX_MIN || Boolean(list.hidden_at)}
>
  {list.hidden_at && (
    <p class="notice list-hidden-note" role="note">Hidden{list.hidden_reason && <>: “{list.hidden_reason}”</>}. Only moderators see this page; its owner sees the list in their own lists. <a href="/admin/lists?status=hidden">Hidden lists</a></p>
  )}
  <header class="explore-head list-head">
    <div>
    <p class="eyebrow">A list by <a href={`/users/${profile.handle}`}>{profile.name}</a></p>
    <h1 class="page-title">{list.title}</h1>
    {list.description && <p class="lede">{list.description}</p>}
    <p class="list-byline">
      <a href={`/users/${profile.handle}`}><Avatar class="list-avatar" name={profile.name} url={avatarUrl(profile.avatar, profile.image)} seed={profile.handle} size={28} />@{profile.handle}</a>
      <span class="muted">{tools.length === 1 ? "1 tool" : `${tools.length} tools`} · Updated {updated}</span>
    </p>
    <div class="hero-ctas">
      <button type="button" class="btn" data-share={path} data-share-title={list.title}><Icon name="share" /><span>Share</span></button>
      {me?.id === profile.id && <a class="btn" href={`/me/lists/${list.id}`}>Edit list</a>}
    </div>
    </div>
  </header>
  {tools.length ? (
    <div class="grid" data-surface="list">{tools.map((t, i) => <ToolCard tool={t} headingLevel="h2" index={i} />)}</div>
  ) : (
    <p class="empty">This list is empty for now.</p>
  )}
  <p class="muted small-note list-foot">
    Lists are made by people on Try Something, not by our editors.
    {me?.id !== profile.id && <>{" "}Something wrong here? <button type="button" class="link-btn" data-report="list" data-target={list.id}><Icon name="flag" />Report this list</button></>}
  </p>
</Base>
