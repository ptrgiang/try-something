---
// PostHog in privacy mode (memory only, no cookies or storage). Base.astro decides whether it runs.
interface Props {
  config: Record<string, string> | null;
}
const { config } = Astro.props;
---
{config && <span hidden data-ship-analytics={JSON.stringify(config)}></span>}
<script>
  import { startShipAnalytics } from "../scripts/ship-analytics";
  startShipAnalytics();
</script>
