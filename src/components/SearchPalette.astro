---
// Ctrl/Cmd+K (or "/") opens a quick search over published tools from any page.
import Icon from "./Icon.astro";
---
<dialog class="palette" data-palette aria-label="Search tools">
  <form class="palette-search" action="/explore" method="get" role="search">
    <Icon name="search" />
    <label class="sr-only" for="palette-q">Search tools</label>
    <input id="palette-q" name="q" type="search" maxlength="80" autocomplete="off" placeholder="Search tools…" role="combobox" aria-expanded="true" aria-controls="palette-results" aria-autocomplete="list" />
    <kbd>Esc</kbd>
  </form>
  <p class="palette-label" data-palette-label>Trending this week</p>
  <ul class="palette-results" id="palette-results" role="listbox" data-palette-results data-surface="palette"></ul>
  <div class="palette-empty" data-palette-empty hidden>
    <div>
      <p class="popular-tags" data-palette-tags></p>
      <p><a href="/submit">Know a tool that fits? Submit it.</a></p>
    </div>
  </div>
  <p class="palette-foot"><span><kbd>↑</kbd> <kbd>↓</kbd> to move</span><span><kbd>Enter</kbd> to open</span><span>All results on <a href="/explore" data-palette-all>Explore</a></span></p>
</dialog>
<script>
  import { mountStickers, stickerCanvas } from "../scripts/stickers";

  const dialog = document.querySelector<HTMLDialogElement>("[data-palette]");
  const input = dialog?.querySelector<HTMLInputElement>("#palette-q");
  const list = dialog?.querySelector<HTMLUListElement>("[data-palette-results]");
  const label = dialog?.querySelector<HTMLElement>("[data-palette-label]");
  const all = dialog?.querySelector<HTMLAnchorElement>("[data-palette-all]");
  const empty = dialog?.querySelector<HTMLElement>("[data-palette-empty]");
  const tagsBox = dialog?.querySelector<HTMLElement>("[data-palette-tags]");
  type Row = { slug: string; name: string; tagline: string; host: string };
  let active = -1;
  let timer = 0;
  let controller: AbortController | null = null;

  // The sticker is built on first use, so pages that never show it don't load the kit.
  function showEmpty(tags: string[]) {
    if (!empty || !tagsBox) return;
    if (!empty.querySelector("canvas")) {
      empty.insertBefore(stickerCanvas("search"), empty.firstChild);
      void mountStickers(empty);
    }
    tagsBox.replaceChildren(
      ...tags.map((t) => {
        const a = document.createElement("a");
        a.href = `/tags/${encodeURIComponent(t)}`;
        a.textContent = t;
        return a;
      }),
    );
    tagsBox.hidden = !tags.length;
    empty.hidden = false;
  }

  function render(rows: Row[], q: string, tags: string[] = []) {
    if (!list || !label || !empty) return;
    if (q && !rows.length) showEmpty(tags);
    else empty.hidden = true;
    label.textContent = q ? (rows.length ? `Tools matching “${q}”` : `Nothing matches “${q}” yet`) : "Trending this week";
    list.replaceChildren(
      ...rows.map((r, i) => {
        const li = document.createElement("li");
        li.setAttribute("role", "option");
        li.id = `palette-opt-${i}`;
        const a = document.createElement("a");
        a.href = `/tools/${r.slug}`;
        const name = document.createElement("strong");
        name.textContent = r.name;
        const host = document.createElement("span");
        host.className = "palette-host";
        host.textContent = r.host;
        const tag = document.createElement("span");
        tag.className = "palette-tagline";
        tag.textContent = r.tagline;
        [name, host, tag].forEach((n) => a.appendChild(n));
        li.appendChild(a);
        return li;
      }),
    );
    select(rows.length ? 0 : -1);
    if (all) all.href = q ? `/explore?q=${encodeURIComponent(q)}` : "/explore";
  }

  function select(i: number) {
    const opts = list ? Array.from(list.children) : [];
    active = opts.length ? (i + opts.length) % opts.length : -1;
    opts.forEach((o, n) => o.setAttribute("aria-selected", String(n === active)));
    if (active >= 0) {
      input?.setAttribute("aria-activedescendant", opts[active].id);
      opts[active].scrollIntoView({ block: "nearest" });
    } else input?.removeAttribute("aria-activedescendant");
  }

  async function search() {
    const q = input?.value.trim() ?? "";
    controller?.abort();
    controller = new AbortController();
    try {
      const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`, { signal: controller.signal });
      if (!res.ok) return;
      const data = (await res.json()) as { results: Row[]; tags?: string[] };
      render(data.results, q, data.tags);
    } catch {}
  }

  function open() {
    if (!dialog || dialog.open) return;
    // Over the quick view, the palette is a second modal on top of it.
    dialog.showModal();
    input!.value = "";
    input!.focus();
    search();
  }

  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll(".header-kbd kbd").forEach((k) => (k.textContent = "⌘ K"));
  }

  if (dialog && input) {
    document.addEventListener("keydown", (e) => {
      const typing = (e.target as Element).closest("input, textarea, select, [contenteditable]");
      if ((e.key === "k" || e.key === "K") && (e.ctrlKey || e.metaKey) && !e.altKey) {
        e.preventDefault();
        open();
      } else if (e.key === "/" && !typing && !e.ctrlKey && !e.metaKey && !e.altKey) {
        e.preventDefault();
        open();
      }
    });
    document.addEventListener("click", (e) => {
      if ((e.target as Element).closest("[data-palette-open]")) {
        e.preventDefault();
        open();
      }
    });
    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = window.setTimeout(search, 120);
    });
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        select(active + (e.key === "ArrowDown" ? 1 : -1));
      } else if (e.key === "Escape") {
        // A search field swallows the first Esc to clear itself; here Esc should always close.
        e.preventDefault();
        dialog.close();
      } else if (e.key === "Enter" && active >= 0) {
        e.preventDefault();
        list?.children[active]?.querySelector("a")?.click();
      }
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
      if ((e.target as Element).closest("a")) dialog.close();
    });
  }
</script>
