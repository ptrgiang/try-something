---
// Follow a person with a public profile. Signed out it's a sign-in link; nothing shows on your own profile.
// The script is bundled once however many buttons a page has.
import Icon from "./Icon.astro";

interface Props {
  person: { id: string; name: string };
  following: boolean;
  class?: string;
}
const { person, following, class: cls } = Astro.props;
const me = Astro.locals.user;
---
{me ? (
  me.id !== person.id && (
    <button type="button" class:list={["btn btn-sm follow-btn", cls]} data-follow={person.id} aria-pressed={following ? "true" : "false"} aria-label={`Follow ${person.name}`}>
      <Icon name="user" /><span>{following ? "Following" : "Follow"}</span>
    </button>
  )
) : (
  <a class:list={["btn btn-sm follow-btn", cls]} href={`/login?next=${encodeURIComponent(Astro.url.pathname)}`} rel="nofollow"><Icon name="user" /><span>Follow</span></a>
)}
<script>
  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>("button[data-follow]");
    if (!btn || btn.disabled) return;
    const id = btn.dataset.follow!;
    const follow = btn.getAttribute("aria-pressed") !== "true";
    const paint = (on: boolean) =>
      document.querySelectorAll<HTMLButtonElement>(`button[data-follow="${CSS.escape(id)}"]`).forEach((b) => {
        b.setAttribute("aria-pressed", on ? "true" : "false");
        const label = b.querySelector("span");
        if (label) label.textContent = on ? "Following" : "Follow";
      });
    // A profile's follower count ([data-followers]) moves with the button; it hides again at zero.
    const count = (delta: number) =>
      document.querySelectorAll<HTMLElement>(`[data-followers="${CSS.escape(id)}"]`).forEach((el) => {
        const n = Math.max(0, Number(el.dataset.count ?? 0) + delta);
        el.dataset.count = String(n);
        el.hidden = n === 0;
        el.querySelector("strong")!.textContent = n.toLocaleString("en-US");
        el.querySelector("span")!.textContent = n === 1 ? "follower" : "followers";
      });
    btn.parentElement?.querySelector(".follow-error")?.remove();
    paint(follow);
    count(follow ? 1 : -1);
    btn.disabled = true;
    try {
      const res = await fetch("/api/follows", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ userId: id, follow }) });
      if (!res.ok) {
        const out = (await res.json().catch(() => null)) as { error?: string } | null;
        throw new Error(res.status === 409 && out?.error ? out.error : "");
      }
    } catch (err) {
      paint(!follow);
      count(follow ? -1 : 1);
      if (err instanceof Error && err.message) {
        const note = document.createElement("p");
        note.className = "form-error follow-error";
        note.setAttribute("role", "alert");
        note.textContent = err.message;
        btn.insertAdjacentElement("afterend", note);
      }
    } finally {
      btn.disabled = false;
    }
  });
</script>
